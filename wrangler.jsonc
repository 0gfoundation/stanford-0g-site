{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apollo-0g-site",
  "compatibility_date": "2026-11-01",
  // Static site only: `next build` writes the export to ./out.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
